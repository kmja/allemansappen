# ----------------------------------------------------------------------------
# Friluftsliv Camping Helper — environment configuration
# Copy to `.env.local` and fill in what you need. Everything has a sane,
# zero-config default; the app runs without setting any of these.
# ----------------------------------------------------------------------------

# --- Basemap -----------------------------------------------------------------
# By default the app uses OpenStreetMap raster tiles (no key required).
# To use a vector style or a custom raster basemap (e.g. Lantmäteriet topo,
# MapTiler, etc.) point this at a MapLibre style JSON URL.
# NEXT_PUBLIC_BASEMAP_STYLE_URL=

# --- Property boundaries (Lantmäteriet fastighetsgränser) --------------------
# This is the access-friction layer: Lantmäteriet's cadastral data generally
# requires an account/agreement. Credentials are read ONLY on the server and
# proxied through /api/lm-tiles, so the secret never reaches the browser.
# Set NEXT_PUBLIC_PROPERTY_LAYER_ENABLED=true to surface the toggle once you
# have configured a working source below. See README → "Lantmäteriet".
# NEXT_PUBLIC_PROPERTY_LAYER_ENABLED=false
#
# A WMS GetMap template. Use {bbox} where the EPSG:3857 bbox should go.
# LANTMATERIET_WMS_TEMPLATE=https://api.lantmateriet.se/.../wms?SERVICE=WMS&REQUEST=GetMap&VERSION=1.3.0&LAYERS=granser&CRS=EPSG:3857&WIDTH=256&HEIGHT=256&FORMAT=image/png&TRANSPARENT=true&BBOX={bbox}
# Auth — either HTTP basic or a bearer token, depending on the product:
# LANTMATERIET_USERNAME=
# LANTMATERIET_PASSWORD=
# LANTMATERIET_TOKEN=

# --- Overpass (OpenStreetMap data: buildings, land use, nature reserves) -----
# Default is the public instance. Override to use a mirror or your own server
# if you hit rate limits.
# OVERPASS_URL=https://overpass-api.de/api/interpreter

# --- SMHI weather ------------------------------------------------------------
# SMHI's open data API needs no key. Nothing to configure.
